# --- required ---

# Replicate token used for every render. Rotate the old one — it was committed
# to git in the legacy render.yaml and should be treated as public.
REPLICATE_API_TOKEN=

# Random 32+ character string. Signs the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Accounts are configured in getUsers() in src/lib/auth.ts.
# STYLER_USERS is no longer read.

# --- optional: usage tracking + daily credits ---
# Render Postgres connection string. Use the *Internal* URL when the database
# and the web service live in the same Render region.
# Leave blank and the app still runs — it just stops counting and renders
# become unmetered.
DATABASE_URL=

# Renders each account gets per day. Resets on the first request after
# midnight UTC. Defaults to 20.
DAILY_CREDITS=20

# Who can see /admin/stats. Comma-separated, case-insensitive. Defaults to
# `admin`.
STYLER_ADMINS=general,bekzat,aleksei

# --- optional: support + issue report email (Resend) ---
# Without these, messages are written to the server log instead of emailed.
RESEND_API_KEY=
SUPPORT_EMAIL_TO=johnwangcpp@gmail.com
SUPPORT_EMAIL_FROM=styler@kaielsystems.com
